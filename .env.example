# Environment variables for WordAndWords
# Copy this file to .env and modify as needed

# Game name (displayed in UI)
GAME_NAME=WordAndWords

# VITE_API_URL=http://localhost:3001

# Web Push (VAPID) keys — generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEVER commit real keys. If left blank, the server generates an ephemeral pair
# on startup (push resets on every restart).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Admin password — REQUIRED in production. Defaults to "admin123" if unset (dev only).
ADMIN_PASSWORD=
# The URL where the game is hosted (required for email links)
SERVER_URL=https://worldandwords.example.com

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
